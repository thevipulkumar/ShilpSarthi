# Lead delivery, primary.
#
# This project uses Formspree's CLI style: forms are declared in formspree.json
# and pushed with `npm run formspree:deploy`. A form defined that way belongs to
# a project and has NO hashid, which is why there is none to find in the
# dashboard. It is addressed by project id plus the form key from that file:
#
#   https://formspree.io/p/<project id>/f/<form key>
#
FORMSPREE_PROJECT_ID=3073570816458227440
FORMSPREE_FORM_KEY=websiteLead

# Only for a form created directly in the dashboard, which does get a hashid.
# Leave blank when using the project style above. A full URL is also accepted.
FORMSPREE_FORM_ID=

# CLI only, never read by the site. Used by `npm run formspree:deploy` to push
# formspree.json. Treat it as a secret: it can change your live form config.
FORMSPREE_DEPLOY_KEY=

# Lead delivery, fallback. Used when Formspree is unset, refuses the submission,
# or the free plan's monthly cap is reached mid-month, which would otherwise
# start rejecting leads exactly while advertising is running.
#
# Web3Forms was the original plan and cannot work from a server: its free tier
# permits client-side submissions only, and answers a server-side POST with
# "This method is not allowed. Use our API in client side or contact support
# with server IP address (Pro plan is required)". Proxying the key server-side,
# which is the entire reason app/api/lead/route.ts exists, is incompatible with
# that plan. Sending from a mailbox on our own domain removes the third party.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
LEAD_TO_EMAIL=homelanesinghmoreranchi@gmail.com

# Optional. Only used if the SMTP_* values above are absent, and only works on a
# Web3Forms Pro account with the server IP whitelisted.
WEB3FORMS_ACCESS_KEY=

# Tracking IDs. These are the EXISTING accounts. Do not create new ones: the
# live Google Ads conversion action and the GA4 property both have history here.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Behold.so Instagram feed. Leave blank until site.features.instagramFeed is on.
NEXT_PUBLIC_BEHOLD_FEED_ID=

