# Web3Forms access key. Kept server-side only: it is read by app/api/lead/route.ts
# and never reaches the browser. On the old site this was in the page source,
# which meant anyone could read it and post junk straight to the endpoint.
WEB3FORMS_ACCESS_KEY=

# Tracking IDs. These are the EXISTING accounts. Do not create new ones: the
# live Google Ads conversion action and the GA4 property both have history here.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Behold.so Instagram feed. Leave blank until site.features.instagramFeed is on.
NEXT_PUBLIC_BEHOLD_FEED_ID=

